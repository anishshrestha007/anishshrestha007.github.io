---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const sections = [
  { id: "work", label: "Work" },
  { id: "experience", label: "Experience" },
  { id: "about", label: "About" },
  { id: "contact", label: "Contact" },
];
---

<header class="side">
  <div class="identity">
    <Logo size={56} class="mark" />
    <h1>{site.name}</h1>
    <p class="role">{site.role}</p>
    <p class="pitch">{site.pitch}</p>
    <div class="actions">
      <a class="button primary" href={site.resume}>Résumé <span class="meta">PDF</span></a>
      <a class="button" href={`mailto:${site.email}`}>Email me</a>
    </div>
  </div>

  <nav class="sections" aria-label="Sections">
    <ul>
      {
        sections.map((s) => (
          <li>
            <a href={`#${s.id}`} data-section={s.id}>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ul class="links">
    {
      site.links.map((link) => (
        <li>
          <a href={link.href} rel="me noopener">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  // Mark the nav link for the section currently in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-section]")].map((a) => [
      a.dataset.section!,
      a,
    ]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const [id, link] of links) {
          if (id === entry.target.id) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
      }
    },
    // A thin band a third of the way down the viewport decides the active section.
    { rootMargin: "-30% 0px -65% 0px" },
  );
  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
</script>

<style>
  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-6);
  }

  .side :global(.mark) {
    margin-left: -4px;
    margin-bottom: var(--space-5);
  }

  h1 {
    font-size: var(--text-display);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .role {
    margin-top: var(--space-3);
    color: var(--ink);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .pitch {
    margin-top: var(--space-4);
    max-width: 34ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .actions .meta {
    color: inherit;
    opacity: 0.7;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  /* Section nav only earns its place once the sidebar is sticky. */
  .sections {
    display: none;
  }

  .sections a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }

  .sections a::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
    transition:
      background-color 0.15s,
      transform 0.15s;
  }

  .sections a:hover,
  .sections a[aria-current] {
    color: var(--ink);
  }

  .sections a[aria-current]::before {
    background: var(--accent-fill);
    transform: scale(1.4);
  }

  .links {
    display: flex;
    gap: var(--space-5);
    font-size: var(--text-sm);
  }

  .links a {
    color: var(--muted);
  }

  .links a:hover {
    color: var(--accent);
  }

  @media (min-width: 62.5rem) {
    .side {
      position: sticky;
      top: 0;
      height: 100dvh;
      justify-content: space-between;
      padding-block: var(--space-9) var(--space-7);
    }

    .sections {
      display: block;
    }
  }
</style>
